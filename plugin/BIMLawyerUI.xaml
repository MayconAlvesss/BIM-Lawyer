<Window x:Class="BIMLawyerPlugin.BIMLawyerUI"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="BIM-Lawyer Audit" Height="450" Width="400"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        Topmost="True" ResizeMode="NoResize" WindowStartupLocation="CenterScreen">
    <Border Background="#1E1E1E" CornerRadius="10" BorderBrush="#333" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="40"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="60"/>
            </Grid.RowDefinitions>
            
            <!-- Draggable Title Bar -->
            <Border Grid.Row="0" Background="#252526" CornerRadius="10,10,0,0" MouseLeftButtonDown="TopBar_MouseLeftButtonDown">
                <TextBlock Text="BIM-Lawyer - Normative Audit Engine" Foreground="White" VerticalAlignment="Center" Margin="15,0,0,0" FontWeight="SemiBold"/>
            </Border>
            
            <!-- Close Button -->
            <Button Grid.Row="0" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,10,0" 
                    Width="24" Height="24" Content="X" Background="Transparent" Foreground="White" BorderThickness="0"
                    Click="Close_Click" FontWeight="Bold"/>

            <!-- Setup Section -->
            <StackPanel Grid.Row="1" Margin="20,15,20,10">
                <TextBlock Text="Select Jurisdiction Code:" Foreground="#CCC" Margin="0,0,0,5"/>
                <ComboBox x:Name="CmbJurisdiction" SelectedIndex="1" Height="30" Background="#333" Foreground="White">
                    <ComboBoxItem Content="ADA (USA)"/>
                    <ComboBoxItem Content="NBR9050 (Brazil)"/>
                    <ComboBoxItem Content="IBC (International)"/>
                </ComboBox>
            </StackPanel>

            <!-- Results Section -->
            <Grid Grid.Row="2" Margin="20,5,20,10">
                <TextBlock Text="Audit Session Log:" Foreground="#CCC" VerticalAlignment="Top"/>
                <TextBox x:Name="TxtLog" Margin="0,20,0,0" Background="#111" Foreground="#4CAF50" 
                         BorderThickness="0" IsReadOnly="True" TextWrapping="Wrap" ScrollViewer.VerticalScrollBarVisibility="Auto"
                         Text="Awaiting launch..."/>
            </Grid>

            <!-- Action Buttons -->
            <Border Grid.Row="3" Background="#252526" CornerRadius="0,0,10,10">
                <Button x:Name="BtnAudit" Content="Execute Normative Audit" Width="200" Height="35" 
                        Background="#007ACC" Foreground="White" FontWeight="Bold" Click="Audit_Click"
                        BorderThickness="0" Cursor="Hand"/>
            </Border>
        </Grid>
    </Border>
</Window>

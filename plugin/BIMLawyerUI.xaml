<Window x:Class="BIMLawyerPlugin.BIMLawyerUI"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="BIM-Lawyer Audit" Height="480" Width="420"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        Topmost="True" ResizeMode="NoResize" WindowStartupLocation="CenterScreen">
    
    <!-- Outer margin for shadow -->
    <Border Margin="10">
        <Border.Effect>
            <DropShadowEffect Color="Black" BlurRadius="20" ShadowDepth="10" Opacity="0.5"/>
        </Border.Effect>

        <!-- Glassmorphism Background -->
        <Border Background="#D0121215" CornerRadius="15" BorderBrush="#40FFFFFF" BorderThickness="1">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="50"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="70"/>
                </Grid.RowDefinitions>
                
                <!-- Draggable Title Bar (Glassier) -->
                <Border Grid.Row="0" Background="#20FFFFFF" CornerRadius="15,15,0,0" MouseLeftButtonDown="TopBar_MouseLeftButtonDown">
                    <Grid>
                        <TextBlock Text="⚖️ BIM-Lawyer Auditor" Foreground="#E0E0E0" VerticalAlignment="Center" Margin="20,0,0,0" FontSize="16" FontWeight="SemiBold"/>
                        <!-- Close Button -->
                        <Button HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,15,0" 
                                Width="30" Height="30" Content="✕" Background="#20FFFFFF" Foreground="White" BorderThickness="0"
                                Click="Close_Click" FontWeight="Bold">
                            <Button.Resources>
                                <Style TargetType="Border">
                                    <Setter Property="CornerRadius" Value="15"/>
                                </Style>
                            </Button.Resources>
                        </Button>
                    </Grid>
                </Border>

                <!-- Setup Section -->
                <StackPanel Grid.Row="1" Margin="25,20,25,10">
                    <TextBlock Text="Select Jurisdiction Code:" Foreground="#B0B0B0" Margin="0,0,0,8" FontSize="13"/>
                    <ComboBox x:Name="CmbJurisdiction" SelectedIndex="1" Height="35" Background="Transparent" Foreground="Black" BorderBrush="#30FFFFFF">
                        <ComboBoxItem Content="ADA (USA)"/>
                        <ComboBoxItem Content="NBR9050 (Brazil)"/>
                        <ComboBoxItem Content="IBC (International)"/>
                    </ComboBox>
                </StackPanel>

                <!-- Results Section -->
                <Grid Grid.Row="2" Margin="25,5,25,10">
                    <TextBlock Text="Live Audit Engine Log:" Foreground="#B0B0B0" VerticalAlignment="Top" FontSize="13"/>
                    <Border Margin="0,25,0,0" Background="#50000000" CornerRadius="8" BorderBrush="#20FFFFFF" BorderThickness="1">
                        <DataGrid x:Name="GridResults" AutoGenerateColumns="False" HeadersVisibility="Column" 
                                  Background="Transparent" RowBackground="Transparent" AlternatingRowBackground="#10FFFFFF"
                                  Foreground="White" BorderThickness="0" GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#20FFFFFF"
                                  IsReadOnly="True" ItemsSource="{Binding}">
                            <DataGrid.Resources>
                                <Style TargetType="DataGridColumnHeader">
                                    <Setter Property="Background" Value="#30000000"/>
                                    <Setter Property="Foreground" Value="#CCCCCC"/>
                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                    <Setter Property="Padding" Value="5"/>
                                </Style>
                            </DataGrid.Resources>
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Rule" Binding="{Binding rule_violated}" Width="110"/>
                                <DataGridTextColumn Header="Status" Binding="{Binding status}" Width="90">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding status}" Value="Compliant">
                                                    <Setter Property="Foreground" Value="#00FF7F"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding status}" Value="Non-Compliant">
                                                    <Setter Property="Foreground" Value="#FF4C4C"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>
                                <DataGridTextColumn Header="Found" Binding="{Binding current_value}" Width="60"/>
                                <DataGridTextColumn Header="Req." Binding="{Binding required_value}" Width="60"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Border>
                </Grid>

                <!-- Action Buttons -->
                <Border Grid.Row="3" Background="#10FFFFFF" CornerRadius="0,0,15,15">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,10,0,10">
                        <Button x:Name="BtnClear" Content="🧹 Clear" Width="80" Height="35" 
                                Background="#30FFFFFF" Foreground="White" FontWeight="Bold" Click="Clear_Click"
                                BorderThickness="1" BorderBrush="#40FFFFFF" Cursor="Hand" Margin="0,0,10,0">
                            <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="8"/></Style></Button.Resources>
                        </Button>
                        
                        <Button x:Name="BtnAudit" Content="🔍 Execute Audit" Width="140" Height="35" 
                                Background="#90007ACC" Foreground="White" FontWeight="Bold" Click="Audit_Click"
                                BorderThickness="1" BorderBrush="#40FFFFFF" Cursor="Hand" Margin="0,0,10,0">
                            <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="8"/></Style></Button.Resources>
                        </Button>

                        <Button x:Name="BtnAutoFix" Content="🔧 Auto-Fix" Width="90" Height="35" 
                                Background="#90FF8C00" Foreground="White" FontWeight="Bold" Click="AutoFix_Click"
                                BorderThickness="1" BorderBrush="#40FFFFFF" Cursor="Hand">
                            <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="8"/></Style></Button.Resources>
                        </Button>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>
    </Border>
</Window>
